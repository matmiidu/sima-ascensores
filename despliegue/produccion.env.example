# Copiar como despliegue/produccion.env (no se sube al repositorio) y completar.
# Dominio con el que se entra. Con "localhost" Caddy usa un certificado propio; con un dominio real que apunte
# a este servidor, pide uno de Let's Encrypt solo.
SIMA_DOMINIO=localhost
# Claves: largas y al azar. Por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(40))"
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
# 1 = la primera vez carga la cartera ficticia del caso y los usuarios de prueba (clave sima). 0 en una empresa real.
SIMA_CARGAR_DEMO=1
SIMA_MANTENEDOR_NOMBRE=Ascensores Altavía
SIMA_MANTENEDOR_INSCRIPCION=
