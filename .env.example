# Copiar como .env (no se sube al repositorio).
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Sin DATABASE_URL se usa SQLite. Con el PostgreSQL de docker-compose:
# DATABASE_URL=postgres://sima:sima@localhost:5432/sima

# Orígenes desde donde se puede iniciar sesión en el panel /admin (separados por coma)
CSRF_TRUSTED_ORIGINS=http://localhost:4173,http://localhost:5173

# Empresa mantenedora que aparece en el informe mensual en PDF (H09)
SIMA_MANTENEDOR_NOMBRE=Ascensores Altavía
# Número de inscripción en el Registro de la Ley 20.296 (vacío: el informe dice que no está registrado)
SIMA_MANTENEDOR_INSCRIPCION=
